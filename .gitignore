# Ignore all files in Temp except Temp/SConscript
Temp/*
!Temp/SConscript

vc140.pdb
.sconsign.dblite
RetroVR/libretro-godot/~*
# MSVC build artifacts (generated alongside the DLL, not needed at runtime)
RetroVR/libretro-godot/*.exp
RetroVR/libretro-godot/*.ilk
RetroVR/libretro-godot/*.lib
RetroVR/libretro-godot/*.pdb

# godot-pdfium build artifacts
RetroVR/godot-pdfium/~*
RetroVR/godot-pdfium/*.exp
RetroVR/godot-pdfium/*.ilk
RetroVR/godot-pdfium/*.lib
RetroVR/godot-pdfium/*.pdb
godot-pdfium/Temp/
godot-pdfium/external/pdfium/include/*.orig

# vlc-godot build artifacts
RetroVR/vlc-godot/~*
RetroVR/vlc-godot/*.exp
RetroVR/vlc-godot/*.ilk
RetroVR/vlc-godot/*.lib
RetroVR/vlc-godot/*.pdb

**/*.import

# The system icons carry a deliberate svg/scale=0.5 — the source art is ~331 px
# on the long edge and the tiles draw it at 60. Without these, a fresh clone
# reimports them at full size for no visual gain.
!RetroVR/Textures/SystemIcons/*.svg.import

# The bedroom's NormalGL maps need compress/normal_map=1 so they import as linear
# normal data rather than sRGB colour. Godot only sets that when the editor
# prompts on assignment, which never happens for a hand-authored .tscn — without
# these a fresh clone renders the walls and carpet nearly flat.
!RetroVR/imported-assets/bedroom/materials/*.import

*.apk

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Blender-specific ignores
*.blend[0-9]*

# Local libretro core root. On Linux default_core_root() is $HOME/retrovr/libretro,
# which lands inside the repo when it's cloned at ~/retrovr. Never commit cores.
/libretro/

/roms/
/dvd/
/books/
/audio/
/videos/
/music/

# metaxr-audio build artifacts (same convention as libretro-godot / godot-pdfium)
RetroVR/metaxr-audio/~*
RetroVR/metaxr-audio/*.exp
RetroVR/metaxr-audio/*.ilk
RetroVR/metaxr-audio/*.lib
RetroVR/metaxr-audio/*.pdb
metaxr-audio-godot/Temp/

# Output of RetroVR/Tools/bedroom_probe.tscn — renders, never source.
RetroVR/probe_out/
*.mp4

# Audio .import files carry compress/mode=0 — QOA-compressed clips cannot be
# decoded to PCM frames for the Meta XR emitter, so the setting must ship.
!RetroVR/Audio/**/*.import
