# Ignore all files in Temp except Temp/SConscript
Temp/*
!Temp/SConscript

vc140.pdb
.sconsign.dblite
RetroVR/SKLibretro/~*
# MSVC build artifacts (generated alongside the DLL, not needed at runtime)
RetroVR/SKLibretro/*.exp
RetroVR/SKLibretro/*.ilk
RetroVR/SKLibretro/*.lib
RetroVR/SKLibretro/*.pdb
**/*.import

*.apk

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
