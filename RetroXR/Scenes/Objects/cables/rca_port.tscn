; A socket, placed the way tv.tscn already places its composite port: the ZONE
; sits where a seated plug's origin belongs, which is 10 mm proud of the panel,
; and the jack is pushed back by that much so its flange lands on the panel.
; Copy this node's transform from an existing port and the plug still seats right.
[node name="RcaPort" instance=ExtResource("1_snapzone")]
grab_distance = 0.06
snap_require = "composite_plug"
script = ExtResource("2_portscript")

[node name="RcaJack" parent="." instance=ExtResource("3_rcajack")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.01002)

[node name="SnapHighlight" type="Node3D" parent="."]
script = ExtResource("4_snaphigh")

[node name="HighlightMesh" type="MeshInstance3D" parent="SnapHighlight"]
