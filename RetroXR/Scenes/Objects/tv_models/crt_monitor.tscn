[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Scripts/Objects/tv/tv_shell.gd" id="1_shell"]
[ext_resource type="PackedScene" path="res://imported-assets/bedroom/displays/crt_monitor.glb" id="2_mon"]

; EDITOR NOTE: see crt_90s.tscn — the shell is a runtime swap, so the editor shows
; RetroTV's stock box body rather than this cabinet.
;
; Beige 90s computer monitor (Sketchfab, fizyman, CC-BY). Its own glass pane is a
; separate mesh and is hidden — the live picture goes on RetroTV's ScreenMesh, and
; two panes in the same place would z-fight.
;
; show_button_row is off: the five bezel caps are 25 mm on a 45-70 mm pitch and
; there is no lip on a monitor to carry them. TVOptionsPanel, which is already
; pointer-driven, is the control surface for this shell.
; NO phono row and NO aerial socket. This is a computer monitor: it takes its
; picture over the DE-15 below, and a bank of phono jacks or a coax tuner hole on the
; back of a VGA monitor is the same anachronism as a SCART socket would be.
;
; The DE-15 is an INPUT in its own right (RetroTV.Source.VGA), not an alias for
; Composite 1, so this cabinet offers exactly one input and SOURCE announces "VGA"
; rather than naming a phono socket it does not have. av_inputs says which phono
; SOCKETS the cabinet carries, which here is none; _source_available reads the DE-15
; separately, and _first_available_source starts the set on it rather than the tuner.
;
; The back could not have taken four groups anyway: a raycast grid reads flat in
; DEPTH for 180 mm, which is misleading, because the moulding holds its distance
; while turning out of the plane. The facet printing can actually sit on is the
; 123 x 46 mm panel around the power inlet.
[node name="CrtMonitor" type="Node3D"]
script = ExtResource("1_shell")
body_size = Vector3(0.406, 0.433, 0.419)
av_inputs = 0
has_aerial = false
show_button_row = false
hide_meshes = PackedStringArray("CRT_Monitor_monitor_glass_0")

[node name="Shell" parent="." instance=ExtResource("2_mon")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0375, -0.0045)

; Seated exactly where the model's own glass was (0.310 x 0.233), so the picture
; fills the bezel rather than floating in it.
[node name="ScreenSeat" type="Marker3D" parent="."]
transform = Transform3D(0.886, 0, 0, 0, 0.932, 0, 0, 0, 0.9, 0, 0.052, 0.203)

; Composite 1's VIDEO socket. The other eleven step off it — the audio pair along
; this marker's local -X on the standard 18 mm pitch, the next input group by
; av_group_step above; see RetroTV._seat_av_row.
;
; z -0.1861, the 10 mm a port stands proud of the panel it seats on, measured off
; the cabinet: rays cast at the three socket columns land on the back at -0.1748,
; -0.1759 and -0.1761, and the marker takes the deepest so nothing sinks. The old
; -0.200 stood the whole row 14 mm off the case, hanging in the air behind it.
[node name="PortSeat" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, -1, -8.7422784e-08, 0, 8.7422784e-08, -1, 0.1, -0.08, -0.1861)

; The monitor's own input, and the only shell in the project that carries this
; marker — a wood-cabinet television has no business with a DE-15. Its presence is
; what switches RetroTV's VgaPort on; see RetroTV._seat_vga_port.
;
; Beside the composite socket on the same back panel, 60 mm to its left so the
; 30.8 mm flange clears the phono jack rather than growing through it. That clearance
; is why this cabinet keeps one input group: a second one lands at exactly this x and
; the DE-15 grows straight through its audio pair. Same basis: 180 about X, so the
; zone's local +Z points out of the back.
;
; z -0.1836, not the composite row's -0.1861: this connector seats its plug 7.5 mm
; proud of the panel rather than the RCA pair's 10 mm, and the marker is where the
; plug's ORIGIN goes. That 7.5 mm is vga_port.tscn's VgaJack offset, read off the
; scene — not the 3 mm its own comment quotes, which sinks the shell into the case
; and leaves a white blank where the DE-15 should be. A ray cast at this column
; lands on the back at -0.1761, so 7.5 mm out of that is -0.1836.
[node name="VgaPortSeat" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, -1, -8.7422784e-08, 0, 8.7422784e-08, -1, 0.04, -0.08, -0.1836)

[node name="AmbilightSeat" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0.052, 0.22)
