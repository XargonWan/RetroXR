[node name="CollisionShape3D" type="CollisionShape3D" parent="CablePlug"]
shape = SubResource("SphereShape3D_plug")

; Baked RCA plug (Tools/gen_rca_plug.gd). No transform: the mesh is authored
; connector-on-+Z, unlike a CylinderMesh which is Y-up and needed rotating. No
; surface_material_override either — the materials are baked into the mesh, and
; surface 0 is deliberately the yellow plastic so system.gd's
; _decorate_channel_plug tints the BODY blue for a dual-screen host's BOTTOM
; channel rather than the metal. The mesh carries its own ribbed strain relief,
; so the separate StrainRelief node is gone.
[node name="PlugTip" type="MeshInstance3D" parent="CablePlug"]
mesh = ExtResource("5_rcaplug")

; Layer 21 (pointable) is the only layer the FunctionPointer's RayCast masks, so
; without this the beam passes straight through the plug — the plug body itself
; sits on layer 3 (pickable). Same StaticBody-child pattern as system.tscn;
; function_pickup._resolve_pickable maps the hit back to the parent pickable.
[node name="PointerArea" type="StaticBody3D" parent="CablePlug"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="CablePlug/PointerArea"]
shape = SubResource("SphereShape3D_pointer")

[node name="PickableHighlight" type="Node3D" parent="CablePlug"]
script = ExtResource("3_pickhigh")

[node name="SnapGrabPoint" parent="CablePlug" instance=ExtResource("4_snapgp")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0)

; 8.3 mm A/V lead (tube_radius 0.00415) — nearly twice the 4.5 mm controller cord
; in controller_cable.tscn, which is right: this is a shielded composite cable.
; collision_radius is the standoff the solver holds each particle at from a contact
; plane, so it has to track the tube or the cord floats; 0.0055 leaves the same
; 1.35 mm resting gap the controller cable uses.
;
; end_stiff_segments counts SEGMENTS, so the boot constraint spans 2 x 30 mm,
; but end_stiffness decides how much of that reads as held. 0.45 tapers it to
; about one segment straight out of the plug, ~30 mm, or 3.6x the 8.3 mm OD —
; a moulded strain relief rather than a rod. Values near 0.8 hold the full
; 60 mm dead straight, which reads as wired in place. bend_stiffness then has
; to carry the curve past it: at 0.05 the body is string, so every degree of a
; 90 deg pull collects into one corner where the boot's taper ends and the
; minimum radius lands at 27 mm, under what an 8.3 mm jacket can take (4-6x OD).
; 0.2 holds it near 90 mm and spreads slack into a belly instead of a kinked
; loop. Do not push it past ~0.3: bend_stiffness sets the long-range constraint
; depth (1 + round(k*3)), and 0.6 costs +24% CPU per cable for a hose look.
;
; 60 x 30 mm = 1.80 m, the length a real composite lead shipped at. The rest
; length is also the tether: every host clamps its plug to segment_count x
; segment_length from the attach point. Length is bought with segment COUNT, not
; a longer segment, so the boot and the minimum bend radius above stay where
; they were tuned in millimetres — but the solver is per-particle, so it costs
; about double (measured 0.56 -> 1.05 ms per cable per physics tick, 8 cables on
; a floor with collision on). 45 x 40 mm is the same 1.80 m for ~0.8 ms if a
; Quest frame budget ever needs it back.
;
; THREE 3 mm wires, not one 8 mm cord: this is the lead that leaves a handheld
; when video out is switched on, and the real thing is a composite pigtail —
; yellow video with white and red audio beside it. tube_radius is the wire's
; RADIUS, so 3 mm across is 0.0015. collision_radius has to cover the whole
; ribbon rather than one wire (3 x tube_radius, the ratio composite_cable.tscn
; uses). A model can override the count and the colours per channel through its
; video-channel descriptor — the DS's bottom screen comes out as a single blue
; wire that way; see RetroSystemModel.get_video_channels.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 60
segment_length = 0.03
constraint_iterations = 8
bend_stiffness = 0.2
tube_radius = 0.0015
tube_sides = 8
smoothing = 2
rope_color = Color(0.15, 0.15, 0.15, 1.0)
ribbon_count = 3
ribbon_colors = PackedColorArray(0.95, 0.74, 0.02, 1, 0.87, 0.87, 0.84, 1, 0.72, 0.08, 0.08, 1)
surface_collision_mask = 7
collision_radius = 0.0045
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.45
end_stiff_segments = 2
