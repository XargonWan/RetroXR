[ext_resource type="Script" path="res://Scripts/Objects/highlights/pickable_highlight.gd" id="2_pickhigh"]

; 55 x 42 x 8 mm — a PlayStation memory card (SCPH-1020); the PS2's is within a
; couple of mm and shares this primitive. Was 55 x 17 x 75: the width was right
; and the other two were roughly double the real card.
[sub_resource type="BoxShape3D" id="BoxShape3D_card"]
size = Vector3(0.055, 0.008, 0.042)

; The LOOSE pointer target: the card plus 10 mm on every face, so a small flat
; object is still findable on a shelf. memory_card.gd swaps this for a box the
; size of the card itself while a console is holding it.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.075, 0.028, 0.062)

