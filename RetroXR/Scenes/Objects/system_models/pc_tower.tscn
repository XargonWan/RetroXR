; --- the sliding tray --------------------------------------------------------
; TrayPivot is what pc_tower_model.gd translates along +Z, and what RetroSystem
; reparents a seated disc to, so the disc rides out of the bay with it. At rest the
; tray is INSIDE the case; only its front lip shows in the bay slot — z 0.159 puts
; that lip 8.5 mm behind the slit face.
[node name="TrayPivot" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.012, 0.335, 0.159)

[node name="Shelf" type="MeshInstance3D" parent="TrayPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.018, 0)
mesh = SubResource("Mesh_tray")
surface_material_override/0 = SubResource("Mat_tray")

[node name="Well" type="MeshInstance3D" parent="TrayPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.0125, 0)
mesh = SubResource("Mesh_well")
surface_material_override/0 = SubResource("Mat_dark")

[node name="Spindle" type="MeshInstance3D" parent="TrayPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.009, 0)
mesh = SubResource("Mesh_spindle")
surface_material_override/0 = SubResource("Mat_tray")

; Where the disc rests. configure_cartridge_slot copies this pose to the snap zone
; while the tray is at REST, which is what RetroSystem expects.
[node name="DiscSeat" type="Marker3D" parent="TrayPivot"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.006, 0)

; --- back face ---------------------------------------------------------------
[node name="Back" type="Node3D" parent="."]

[node name="AvAnchor" type="Marker3D" parent="Back"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.05, 0.13, -0.222)

; PS/2 keyboard + mouse sockets, on the I/O panel near the top of the back — where
; an AT/ATX tower puts them. Stacked vertically, mouse above keyboard.
;
; CylinderMesh runs along its own Y, so the basis rotates +90 about X to lay it
; along Z and face out of the back panel. Written transposed, as .tscn stores it:
; args are [x.x, y.x, z.x, x.y, y.y, z.y, x.z, y.z, z.z], so y maps to +Z here.
[node name="Ps2Keyboard" type="MeshInstance3D" parent="Back"]
transform = Transform3D(1, 0, 0, 0, 0, -1, 0, 1, 0, -0.055, 0.340, -0.221)
mesh = SubResource("Mesh_ps2")
surface_material_override/0 = SubResource("Mat_ps2_kb")

[node name="Ps2KeyboardBore" type="MeshInstance3D" parent="Back"]
transform = Transform3D(1, 0, 0, 0, 0, -1, 0, 1, 0, -0.055, 0.340, -0.2225)
mesh = SubResource("Mesh_ps2_bore")
surface_material_override/0 = SubResource("Mat_dark")

[node name="Ps2Mouse" type="MeshInstance3D" parent="Back"]
transform = Transform3D(1, 0, 0, 0, 0, -1, 0, 1, 0, -0.055, 0.372, -0.221)
mesh = SubResource("Mesh_ps2")
surface_material_override/0 = SubResource("Mat_ps2_ms")

[node name="Ps2MouseBore" type="MeshInstance3D" parent="Back"]
transform = Transform3D(1, 0, 0, 0, 0, -1, 0, 1, 0, -0.055, 0.372, -0.2225)
mesh = SubResource("Mesh_ps2_bore")
surface_material_override/0 = SubResource("Mat_dark")

; Where the plugs seat, rotated 180 about X.
;
; NOT identity, which was the first guess and put the plug in backwards — barrel
; buried in the case, connector poking out the back. The snap zone does not seat a
; pickable at the zone's own basis: SnapGrabPoint in controller_cable.tscn is
; itself rotated 180 about X, and that composes in, so a zone at identity yields a
; plug at diag(1,-1,-1). Pre-cancelling it here lands the plug at identity, which
; for a BACK-facing socket drives the connector (+Z on the mesh) into the case and
; trails the cord (-Z) out the back.
;
; Measured, not derived — the derivation is what got it backwards. A front-facing
; socket wants a different correction again; see nes_model.gd's roll.
;
; Port 1 = keyboard, matching the purple socket above it; port 2 = mouse.
[node name="PortSeat1" type="Marker3D" parent="Back"]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, -0.055, 0.340, -0.221)

[node name="PortSeat2" type="Marker3D" parent="Back"]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, -0.055, 0.372, -0.221)

; The video card's socket, on the I/O panel directly under the PS/2 stack — where a
; board with onboard video puts it. y 0.318 is 22 mm below the keyboard socket, so
; the 12.6 mm flange clears that 15 mm barrel by 8 mm; the 30.8 mm flange spans
; x -0.070..-0.040, well inside the 190 mm case.
;
; Authored here rather than built by system.gd::_build_av_ports, which only knows
; how to lay out a row of RCA channels. RcaPort.get_device() walks UP for
; on_av_topology_changed, and this model is a child of the RetroSystem, so a socket
; dropped into the model scene resolves its device with no wiring of its own.
;
; z -0.224, not -0.221: the zone sits where a seated plug's ORIGIN belongs, which
; for this connector is 3 mm proud of the panel — the male hood face stops against
; the female shell's rim. The jack child inside vga_port.tscn carries the matching
; -3 mm so its flange lands on the panel at -0.221. NOT the RCA pair's 10 mm.
;
; Rotated 180 about X for the same measured reason PortSeat1/2 above are: a zone at
; identity yields a plug at diag(1,-1,-1) with its hood buried in the case.
;
; direction = 0 is OUT. `channel` is not set here — VgaPort pins it to VIDEO, since
; VGA has no other channel to carry. The tower keeps its three RCA sockets: sound
; still has to leave on those, exactly as it did on the real machine.
[node name="VgaPort" parent="Back" instance=ExtResource("2_vgaport")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, -0.055, 0.318, -0.2285)
direction = 0
