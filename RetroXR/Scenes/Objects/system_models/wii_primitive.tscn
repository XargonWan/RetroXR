; Glossy, the way the real shell is: this machine is lacquered white plastic, not the
; matte grey every placeholder wears. Roughness 0.15 with a clearcoat over it, which
; is what puts a tight bright highlight on the panel instead of a broad soft one.
;
; Gloss is the ONLY thing carrying the shape here. These rooms light with a flat
; ambient and no radiance map, so a matte white slab renders as one even field with
; no edge, no falloff and nothing to say it is a solid object; the specular from the
; room's own lamps is the whole of the modelling.
[sub_resource type="StandardMaterial3D" id="Mat_white"]
albedo_color = Color(0.93, 0.93, 0.915, 1)
metallic_specular = 0.6
roughness = 0.15
clearcoat_enabled = true
clearcoat = 0.65
clearcoat_roughness = 0.04

; A shade off the body so a key or a door reads as a separate part in flat ambient,
; where there is no shadow to draw the join. Same lacquer as the shell, a touch less
; sharp — a moulded key is never quite as polished as the panel it sits in.
[sub_resource type="StandardMaterial3D" id="Mat_offwhite"]
albedo_color = Color(0.885, 0.885, 0.868, 1)
metallic_specular = 0.6
roughness = 0.17
clearcoat_enabled = true
clearcoat = 0.55
clearcoat_roughness = 0.05

[sub_resource type="StandardMaterial3D" id="Mat_seam"]
albedo_color = Color(0.42, 0.42, 0.41, 1)
roughness = 0.55

[sub_resource type="StandardMaterial3D" id="Mat_grey"]
albedo_color = Color(0.40, 0.41, 0.43, 1)
roughness = 0.52

; The recess behind an open door: dark, but not as dark as the slit in it, or the one
; vanishes into the other. UNSHADED for the same reason the slot is — lit, a dark
; recess comes back mid-grey off its specular alone, and this one was reading as pale
; as the shell it is cut into.
[sub_resource type="StandardMaterial3D" id="Mat_bay"]
shading_mode = 0
albedo_color = Color(0.135, 0.135, 0.15, 1)

; UNSHADED, which is the whole trick. Shaded, a near-black surface facing a lamp
; comes back mid-GREY: 0.045 albedo contributes nothing but the specular lobe does,
; and the disc slot rendered as a lit grey column with a gradient down it. A hole is
; not a dark surface, it is an absence of one, so it makes its own black — the same
; call gen_rca_jack.gd makes for a socket bore.
[sub_resource type="StandardMaterial3D" id="Mat_dark"]
shading_mode = 0
albedo_color = Color(0.035, 0.035, 0.042, 1)

; SYNC is the one coloured control on the machine, and that is the point: it is the
; button a player has to be told about, so it does not get to look like the keys.
[sub_resource type="StandardMaterial3D" id="Mat_sync"]
albedo_color = Color(0.85, 0.26, 0.14, 1)
roughness = 0.45

; Emissive, not lit: these rooms light with a flat ambient and no radiance map, so a
; merely blue box reads as a blue box. The slot light has to make its own.
;
; Dim, and only half a millimetre proud of the slit each side. On the real machine
; the slot is plain black and the blue only comes up when there is a message waiting,
; so anything brighter than a hairline stops being a lit slot and starts being neon.
[sub_resource type="StandardMaterial3D" id="Mat_glow"]
albedo_color = Color(0.10, 0.38, 0.95, 1)
emission_enabled = true
emission = Color(0.12, 0.42, 1, 1)
emission_energy_multiplier = 0.3

; LAID DOWN. Everything under this node is still authored standing on end, because
; that is the frame the front panel was measured in and the frame every baked mesh is
; extruded in; the root simply turns the finished machine onto its side.
;
; Rz(+90) maps local (x, y) to (-y, x), so the 44 mm thin axis becomes the height
; and the 157 mm upright height becomes the width, leaving the 215.4 mm depth alone —
; 157 wide x 44 high x 215 deep, read from the front face. The disc
; slot lands horizontal in the upper half of the front face and the key column lands
; as a ROW in the lower half, POWER at the left end through to EJECT at the right.
;
; The offset then drops the machine onto y = 0 and centres it: the body ran y 0.020
; .. 0.2354 standing up, so +0.022 in y seats it and +0.1277 in x centres it.
;
; Because this node is no longer identity, the model's own local coordinates are NOT
; the cabinet's any more. Every hook in wii_model.gd that hands a pose to a node
; owned by the RetroSystem — buttons, controller ports, phono sockets, the disc slot
; — works in GLOBAL transforms for that reason. Reverting any of them to `.position`
; puts that part back where the machine would be if it were still upright.
;
; Written as matrix ROWS, which is what the nine numbers in a .tscn are.
[node name="WiiModel" type="Node3D"]
transform = Transform3D(0, -1, 0, 1, 0, 0, 0, 0, 1, 0.0785, 0.022, 0)
script = ExtResource("1_wii")

[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0785, 0)
mesh = ExtResource("2_wiibody")
surface_material_override/0 = SubResource("Mat_white")

; --- front face, at z +0.0785 -------------------------------------------------
; The printed words are NOT counter-turned for the laid-down machine. They are
; authored the way the real ones are silk-screened — for the upright orientation —
; so on a console lying flat they read sideways, which is exactly what the hardware
; does and what a photograph of it shows.
; A bare Node3D at identity, so its children's local positions ARE model-root
; positions — configure_buttons reads the caps' own `position` and hands it to
; VRButtons that live on the RetroSystem. Give this node a transform and that
; silently breaks, the same trap pc_tower.tscn's Front/Back carry.
[node name="Front" type="Node3D" parent="."]

