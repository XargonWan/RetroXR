# Nintendo - 3DS (Azahar), retroXR build.
#
# Overrides the vendored libretro-core-info entry of the same name. See the
# dolphin one beside it for why an override lives here rather than as an edit
# to res://libretro-core-info, which is vendored wholesale from upstream.
#
# Built from XenuIsWatching/azahar, branch libretro-stereo-options, and
# published on that repository's releases page — GPLv2+, so the source travels
# with the binary. The change is an open pull request upstream
# (azahar-emu/azahar#2339); when it merges, the buildbot's build will do and
# this override and the CoreSources entry can both go.

# Software Information
display_name = "Nintendo - 3DS (Azahar, retroXR)"
authors = "Azahar Emulator"
supported_extensions = "3ds|3dsx|z3dsx|elf|axf|cci|zcci|cxi|zcxi|app"
corename = "Azahar (retroXR)"
categories = "Emulator"
license = "GPLv2+"
permissions = ""
display_version = "retroXR build"

# Hardware Information
manufacturer = "Nintendo"
systemname = "3DS"
systemid = "3ds"

# Libretro Information
database = "Nintendo - Nintendo 3DS"
supports_no_game = "false"
savestate = "true"
savestate_features = "basic"
cheats = "false"
input_descriptors = "true"
memory_descriptors = "false"
libretro_saves = "true"
core_options = "true"
core_options_version = "1.0"
load_subsystem = "false"
hw_render = "true"
required_hw_api = "OpenGL Core >= 3.3"
needs_fullpath = "true"
disk_control = "false"
is_experimental = "false"
notes = "(!) Adds citra_render_3d and citra_factor_3d, which the n3ds cabinet sets to side-by-side and drives from its 3D depth slider.|(!) Installs over the buildbot's Azahar under the same name, so saves and the system folder carry across.|(!) Requires decrypted ROMs; some games want Mii data dumped from your own console."

description = "Azahar for the 3DS, built from retroXR's fork. It is the stock libretro Azahar plus one addition: the stereoscopic 3D settings are exposed as core options. The renderer and the framebuffer layout have always honoured render_3d and factor_3d — the libretro glue was the only place that never surfaced them, so no frontend could ask for a side-by-side frame. With citra_render_3d = side-by-side the core emits both eyes in one frame and the cabinet presents each half to one eye, which is real per-eye depth rather than the parallax barrier the handheld faked. citra_factor_3d is the depth slider on the console itself, live while a game runs. With render_3d off the behaviour is identical to upstream. The change is an open pull request to azahar-emu/azahar (#2339)."
