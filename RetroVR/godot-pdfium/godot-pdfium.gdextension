[configuration]

entry_symbol = "godot_pdfium_library_init"
compatibility_minimum = "4.4.1"
reloadable = true

[libraries]

windows.debug.x86_64 = "godot-pdfium.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "godot-pdfium.windows.template_release.x86_64.dll"
android.debug.arm64 = "libgodot-pdfium.android.template_debug.arm64.so"
android.release.arm64 = "libgodot-pdfium.android.template_release.arm64.so"
