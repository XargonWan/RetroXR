; Floor cushions. Poly Haven's throw_pillows_01 ships ONE colourway: a bold
; red/black/yellow CHEVRON print at 0.772 mean saturation, busier and louder than
; the red rug that had to go for dominating the room.
;
; The albedo texture is dropped entirely. Inspecting the three maps settled it —
; the chevron exists only in the diffuse, while the normal map carries nothing but
; folds and wrinkles and the roughness nothing but weave. So a flat albedo colour
; plus the original normal and roughness gives plain cushions that still crease
; and catch light like fabric. Recolouring the diffuse was tried first and failed
; for the obvious reason in hindsight: preserving its luminance preserved the
; print. A material tint cannot help either, since albedo_color multiplies —
; orange times green is mud, not sage.
[sub_resource type="StandardMaterial3D" id="Mat_cushion_cream"]
albedo_color = Color(0.86, 0.82, 0.74, 1)
roughness_texture = ExtResource("43_cu_rgh")
normal_enabled = true
normal_texture = ExtResource("42_cu_nrm")

[sub_resource type="StandardMaterial3D" id="Mat_cushion_sage"]
albedo_color = Color(0.61, 0.66, 0.56, 1)
roughness_texture = ExtResource("43_cu_rgh")
normal_enabled = true
normal_texture = ExtResource("42_cu_nrm")

[sub_resource type="StandardMaterial3D" id="Mat_cushion_tan"]
albedo_color = Color(0.76, 0.66, 0.52, 1)
roughness_texture = ExtResource("43_cu_rgh")
normal_enabled = true
normal_texture = ExtResource("42_cu_nrm")

