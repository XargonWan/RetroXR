mesh = SubResource("Mesh_kerb")
surface_material_override/0 = SubResource("Mat_kerb")

[node name="KerbFar" type="MeshInstance3D" parent="Exterior"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.02, -23.8)
mesh = SubResource("Mesh_kerb")
surface_material_override/0 = SubResource("Mat_kerb")

