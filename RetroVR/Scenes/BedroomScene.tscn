[node name="ButtonMesh" type="MeshInstance3D" parent="Furniture/LightSwitch/Button"]
mesh = SubResource("Mesh_lever")
surface_material_override/0 = SubResource("Mat_lever")

; Fan blades spin about the hub; the glass shade must ride the STATIC mount or
; the light swings round the room with them (the den learned this the hard way).
[node name="FanPivot" type="Node3D" parent="Furniture"]
script = ExtResource("35_glow")
glow_meshes = PackedStringArray("defaultMaterial4")
glow_color = Color(1, 0.82, 0.55, 1)
glow_energy = 2.2

[node name="Fan" parent="Furniture/FanPivot" instance=ExtResource("14_fan")]
transform = Transform3D(0.00283, 0, 0, 0, 0.00283, 0, 0, 0, 0.00283, 0.2181, 0.4982, -0.5128)

; 2 s per revolution, half the den's 4 s. Four seconds is 15 rpm, slower than any
; real fan and it reads as coasting to a stop rather than running. At 30 rpm a
; four-blade fan passes a blade every 0.5 s, nowhere near the 72 Hz refresh, so
; there is no strobing.
;
; The pivot is at the world origin and the hub sits at (0, 2.39, 0), so rotating
; about Y already turns the blades about their own axis — no offset to correct,
; unlike the den's 3-blade fan whose asymmetric AABB put the pivot 0.111 m off
; centre. FanGlobeLight is parented to the scene root, not to the pivot, so the
; light does not swing round the room with the blades.
[node name="FanSpin" type="AnimationPlayer" parent="Furniture"]
libraries = {
&"": SubResource("AnimLib_fan")
}
autoplay = "spin"

; Baseboard. Runs are unit meshes scaled along the wall direction; the cap sits
; 4 mm prouder than the base.
; --- Furniture colliders ------------------------------------------------------
; RetroTV is a RigidBody3D, so anything it rests on needs a collider or it falls
; straight through to the floor — which is exactly what happened to both displays
; on the first pass. Same convention as the den: a StaticBody3D per piece with a
; hand-fitted BoxShape3D, collision_mask = 0 so they collide-with nothing
; themselves.
[node name="FurnitureCollision" type="StaticBody3D" parent="."]
collision_mask = 0

[node name="DeskTopCol" type="CollisionShape3D" parent="FurnitureCollision"]
