; --- Dressing: rug, posters, wardrobe ----------------------------------------
; Artwork is generated by Tools/gen_bedroom_art.py rather than downloaded, so no
; licence attaches to any of it. See that script.
[sub_resource type="PlaneMesh" id="Mesh_rug"]
size = Vector2(2.4, 1.7)

; No albedo tint. The red rug needed 0.66 to stop it shouting; the taupe
; colourway carries its own muted values, and tinting a muted texture again only
; darkens it — the same double-application that turned the walls orange.
[sub_resource type="StandardMaterial3D" id="Mat_rug"]
albedo_texture = ExtResource("32_rug")
roughness = 0.95

[sub_resource type="BoxMesh" id="Mesh_poster_frame"]
size = Vector3(0.66, 0.88, 0.03)

[sub_resource type="StandardMaterial3D" id="Mat_poster_frame"]
albedo_color = Color(0.13, 0.08, 0.05, 1)
roughness = 0.6

[sub_resource type="QuadMesh" id="Quad_poster"]
size = Vector2(0.6, 0.8)

; A trace of emission on both posters — 0.10, down from 0.30. Print has no light
; of its own, and at 0.30 the glow was adding apparent contrast to art that was
; already four times the room's saturation and eight times its luminance spread.
; Tools/gen_bedroom_art.py now runs both through print_look(), which lifts the
; blacks, caps the whites and desaturates, so they no longer need the glow to read
; at the distance they are actually seen from.
[sub_resource type="StandardMaterial3D" id="Mat_poster_a"]
albedo_texture = ExtResource("33_poster_a")
roughness = 0.9
emission_enabled = true
emission_energy_multiplier = 0.1
emission_texture = ExtResource("33_poster_a")

[sub_resource type="StandardMaterial3D" id="Mat_poster_b"]
albedo_texture = ExtResource("34_poster_b")
roughness = 0.9
emission_enabled = true
emission_energy_multiplier = 0.1
emission_texture = ExtResource("34_poster_b")

; Wardrobe, built from boxes in the room's own trim material. A painted wardrobe
; is flat panels and square corners with nothing organic in it, so it is one of
; the few pieces that loses nothing to primitives - the same reasoning as the
; desk. It also avoids the 30.2k triangles of the downloadable louvred wardrobe,
; whose slats would have made it the heaviest object in the room and would
; shimmer at distance under VR's temporal sampling.
[sub_resource type="BoxMesh" id="Mesh_wr_plinth"]
size = Vector3(1.18, 0.07, 0.55)

[sub_resource type="BoxMesh" id="Mesh_wr_carcass"]
size = Vector3(1.2, 1.9, 0.58)

[sub_resource type="BoxMesh" id="Mesh_wr_cornice"]
size = Vector3(1.28, 0.07, 0.64)

[sub_resource type="BoxMesh" id="Mesh_wr_door"]
size = Vector3(0.57, 1.78, 0.02)

[sub_resource type="BoxMesh" id="Mesh_wr_panel"]
size = Vector3(0.45, 1.6, 0.03)

[sub_resource type="CylinderMesh" id="Mesh_wr_handle"]
top_radius = 0.012
bottom_radius = 0.012
height = 0.16

; The panels need their own tint. A raised panel normally reads by its shadow
; line, but this room is lit almost entirely by ambient plus one globe, so a
; 10 mm step in the same colour showed nothing at all and both doors looked like
; flat slabs. Eight percent darker reads as a panel under any lighting.
[sub_resource type="StandardMaterial3D" id="Mat_wr_panel"]
albedo_color = Color(0.79, 0.77, 0.72, 1)
roughness = 0.55

[sub_resource type="StandardMaterial3D" id="Mat_handle"]
albedo_color = Color(0.75, 0.76, 0.78, 1)
metallic = 0.9
roughness = 0.35

