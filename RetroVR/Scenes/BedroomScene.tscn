; Wall-to-wall carpet. uv1_scale 4 puts roughly one 1K tile per 1.3 m, so the
; pile reads as texture at standing height rather than as a visible repeat.
[sub_resource type="StandardMaterial3D" id="Mat_carpet"]
albedo_color = Color(0.95, 0.92, 0.86, 1)
albedo_texture = ExtResource("23_rug_col")
roughness_texture = ExtResource("25_rug_rgh")
normal_enabled = true
normal_scale = 1.0
normal_texture = ExtResource("24_rug_nrm")
uv1_scale = Vector3(4, 4, 1)

; Orange-peel drywall (ambientCG PaintedPlaster017, surface photogrammetry).
; The source is white, so albedo_color tints it cream — one texture set can
; re-skin every wall in the project at any colour.
;
; The normal map is the reason this beats a flat colour: shadows are OFF on Quest,
; so per-pixel normals are the only thing giving the walls form. It only shows
; under directional light, which is what the bedside and desk lamps are for.
[sub_resource type="StandardMaterial3D" id="Mat_wall"]
albedo_color = Color(0.78, 0.71, 0.58, 1)
albedo_texture = ExtResource("20_wall_col")
roughness_texture = ExtResource("22_wall_rgh")
normal_enabled = true
normal_scale = 1.0
normal_texture = ExtResource("21_wall_nrm")
uv1_scale = Vector3(2.5, 2.5, 1)

[sub_resource type="StandardMaterial3D" id="Mat_ceiling"]
albedo_color = Color(0.78, 0.75, 0.7, 1)
roughness = 0.95

; One shared trim material for baseboard, door casing and window casing, so the
; room's woodwork all matches. Slightly glossier than the wall so it reads as
; painted trim rather than more drywall.
[sub_resource type="StandardMaterial3D" id="Mat_trim"]
albedo_color = Color(0.88, 0.86, 0.81, 1)
roughness = 0.55

