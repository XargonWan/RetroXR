; 4.5 mm cord (tube_radius 0.00225). collision_radius has to come down with it:
; it is the standoff the solver holds each particle at from a contact plane, so
; leaving it at the class default 0.008 would float a 4.5 mm cable 5.75 mm clear
; of every desk and floor it lies on.
;
; Same strain-relief reasoning as cable.tscn, scaled to a thinner cord: 2
; segments of boot is 70 mm here (segment_length 0.035), and bend_stiffness sits
; below the A/V lead's 0.2 because a 4.5 mm cord really does take a tighter bend
; radius before it kinks.
[node name="VerletRope" type="MeshInstance3D" parent="."]
script = ExtResource("2_ropescript")
segment_count = 24
segment_length = 0.035
constraint_iterations = 8
bend_stiffness = 0.15
tube_radius = 0.00225
tube_sides = 8
smoothing = 2
rope_color = Color(0.15, 0.15, 0.15, 1.0)
surface_collision_mask = 7
collision_radius = 0.0036
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.8
end_stiff_segments = 2
