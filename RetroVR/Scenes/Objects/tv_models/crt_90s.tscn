[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Scripts/Objects/tv_shell.gd" id="1_shell"]
[ext_resource type="PackedScene" path="res://imported-assets/bedroom/displays/television_02.gltf" id="2_tv"]

; EDITOR NOTE: the cabinet only appears at RUN time. tv.gd swaps the shell in from
; _ready(), and neither it nor XRToolsPickable is a @tool script, so in the editor
; a RetroTV still draws its stock 0.5 x 0.4 x 0.3 TVBody box. Open this scene to
; see the cabinet, or press play. Making it preview in-editor means marking tv.gd
; @tool and guarding _process/_physics_process, which risks the arcade and den TVs.
;
; 14" 90s set (Poly Haven "Television 02", CC0). The GLB sits base-at-origin and
; faces +Z; RetroTV's own origin is the CENTRE of its stock 0.5 x 0.4 x 0.3 body,
; so Shell is offset down half its height and re-centred in X/Z.
[node name="Crt90s" type="Node3D"]
script = ExtResource("1_shell")
body_size = Vector3(0.4, 0.411, 0.35)
button_pitch = 0.045
show_button_row = true

[node name="Shell" parent="." instance=ExtResource("2_tv")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.002, -0.2055, 0.053)

; Scale on this marker sizes the tube: the stock curved mesh is 0.35 x 0.25, and
; this cabinet's picture area is ~0.30 x 0.225. The OSD labels are children of
; ScreenMesh and ride the same scale, so they stay proportional.
[node name="ScreenSeat" type="Marker3D" parent="."]
transform = Transform3D(0.857, 0, 0, 0, 0.9, 0, 0, 0, 0.9, 0, 0.035, 0.174)

; Composite in on the back panel, right side. Rotation matches the stock port so
; the plug still arrives nose-first.
[node name="PortSeat" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, -1, -8.7422784e-08, 0, 8.7422784e-08, -1, 0.12, -0.1, -0.178)

[node name="AmbilightSeat" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0.035, 0.185)

; First cap of the bezel row; the rest step along local +X by button_pitch.
[node name="ButtonRow" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.09, -0.178, 0.168)

[node name="VolumeLabelSeat" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.16, -0.178, 0.168)
